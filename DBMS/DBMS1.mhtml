<th style=3D"text-align:center">Bob</th>
<th style=3D"text-align:center">Status</th>
</tr>
</thead>
<tbody>
<tr>
<td style=3D"text-align:center">0</td>
<td>Before transaction</td>
<td style=3D"text-align:center">1000</td>
<td style=3D"text-align:center">2000</td>
<td style=3D"text-align:center">Saved on disk</td>
</tr>
<tr>
<td style=3D"text-align:center">1</td>
<td>Debit Alice</td>
<td style=3D"text-align:center"><strong>500</strong></td>
<td style=3D"text-align:center">2000</td>
<td style=3D"text-align:center">In memory only</td>
</tr>
<tr>
<td style=3D"text-align:center">2</td>
<td>Credit Bob</td>
<td style=3D"text-align:center">500</td>
<td style=3D"text-align:center"><strong>2500</strong></td>
<td style=3D"text-align:center">In memory only</td>
</tr>
<tr>
<td style=3D"text-align:center">3</td>
<td><strong>COMMIT</strong></td>
<td style=3D"text-align:center">500</td>
<td style=3D"text-align:center">2500</td>
<td style=3D"text-align:center">=E2=9C=85 <strong>Saved to disk permanently=
</strong> (via the log)</td>
</tr>
</tbody>
</table></div>
