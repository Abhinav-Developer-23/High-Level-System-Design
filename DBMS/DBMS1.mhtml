</tr>
<tr>
<td><code>{email, dept}</code></td>
<td style=3D"text-align:center">=E2=9C=85</td>
<td style=3D"text-align:center">=E2=9D=8C (<code>dept</code> is redundant)<=
/td>
</tr>
<tr>
<td><code>{roll_no, name, email, phone, dept}</code></td>
<td style=3D"text-align:center">=E2=9C=85</td>
<td style=3D"text-align:center">=E2=9D=8C (all columns =E2=80=94 way more t=
han needed)</td>
</tr>
<tr>
<td><code>{name}</code></td>
<td style=3D"text-align:center">=E2=9D=8C (names can repeat)</td>
<td style=3D"text-align:center">=E2=80=94</td>
</tr>
<tr>
<td><code>{dept}</code></td>
<td style=3D"text-align:center">=E2=9D=8C (departments repeat)</td>
