hljs"><span class=3D"hljs-keyword">SELECT</span> e.name <span class=3D"hljs=
-keyword">AS</span> Employee, m.name <span class=3D"hljs-keyword">AS</span>=
 Manager
<span class=3D"hljs-keyword">FROM</span> employees e
<span class=3D"hljs-keyword">LEFT</span> <span class=3D"hljs-keyword">JOIN<=
/span> employees m <span class=3D"hljs-keyword">ON</span> e.manager_id <spa=
