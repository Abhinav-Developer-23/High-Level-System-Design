<h3 id=3D"complete-example--process-employee-bonuses" data-toc=3D"Complete =
Example =E2=80=94 Process Employee Bonuses">Complete Example =E2=80=94 Proc=
ess Employee Bonuses</h3>
<h4 id=3D"scenario">Scenario</h4>
<p>Give a 10% bonus to employees earning &lt; 50000 and a 5% bonus to every=
one else, logging each action:</p>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-comment">-- SQL Server Example</span>
<span class=3D"hljs-keyword">DECLARE</span> <span class=3D"hljs-variable">@=
emp_id</span> <span class=3D"hljs-type">INT</span>, <span class=3D"hljs-var=
iable">@name</span> <span class=3D"hljs-type">VARCHAR</span>(<span class=3D=
"hljs-number">50</span>), <span class=3D"hljs-variable">@salary</span> <spa=
n class=3D"hljs-type">DECIMAL</span>(<span class=3D"hljs-number">10</span>,=
<span class=3D"hljs-number">2</span>), <span class=3D"hljs-variable">@bonus=
</span> <span class=3D"hljs-type">DECIMAL</span>(<span class=3D"hljs-number=
">10</span>,<span class=3D"hljs-number">2</span>);

<span class=3D"hljs-comment">-- Step 1: DECLARE the cursor</span>
<span class=3D"hljs-keyword">DECLARE</span> emp_cursor <span class=3D"hljs-=
keyword">CURSOR</span> <span class=3D"hljs-keyword">FOR</span>
    <span class=3D"hljs-keyword">SELECT</span> emp_id, name, salary <span c=
lass=3D"hljs-keyword">FROM</span> employees;

<span class=3D"hljs-comment">-- Step 2: OPEN the cursor</span>
<span class=3D"hljs-keyword">OPEN</span> emp_cursor;

<span class=3D"hljs-comment">-- Step 3: FETCH first row</span>
<span class=3D"hljs-keyword">FETCH</span> NEXT <span class=3D"hljs-keyword"=
>FROM</span> emp_cursor <span class=3D"hljs-keyword">INTO</span> <span clas=
s=3D"hljs-variable">@emp_id</span>, <span class=3D"hljs-variable">@name</sp=
an>, <span class=3D"hljs-variable">@salary</span>;

<span class=3D"hljs-comment">-- Step 4: LOOP through each row</span>
WHILE @<span class=3D"hljs-variable">@FETCH_STATUS</span> <span class=3D"hl=
js-operator">=3D</span> <span class=3D"hljs-number">0</span>
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-comment">-- Custom logic per row</span>
    IF <span class=3D"hljs-variable">@salary</span> <span class=3D"hljs-ope=
rator">&lt;</span> <span class=3D"hljs-number">50000</span>
        <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variabl=
e">@bonus</span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hl=
js-variable">@salary</span> <span class=3D"hljs-operator">*</span> <span cl=
ass=3D"hljs-number">0.10</span>;    <span class=3D"hljs-comment">-- 10% bon=
us</span>
    <span class=3D"hljs-keyword">ELSE</span>
        <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variabl=
e">@bonus</span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hl=
js-variable">@salary</span> <span class=3D"hljs-operator">*</span> <span cl=
ass=3D"hljs-number">0.05</span>;    <span class=3D"hljs-comment">-- 5% bonu=
s</span>

    <span class=3D"hljs-comment">-- Update the employee&#x27;s record</span=
>
    <span class=3D"hljs-keyword">UPDATE</span> employees <span class=3D"hlj=
s-keyword">SET</span> bonus <span class=3D"hljs-operator">=3D</span> <span =
class=3D"hljs-variable">@bonus</span> <span class=3D"hljs-keyword">WHERE</s=
pan> emp_id <span class=3D"hljs-operator">=3D</span> <span class=3D"hljs-va=
riable">@emp_id</span>;

    <span class=3D"hljs-comment">-- Log the action</span>
    <span class=3D"hljs-keyword">INSERT</span> <span class=3D"hljs-keyword"=
>INTO</span> bonus_log (emp_id, name, bonus_amount, processed_at)
    <span class=3D"hljs-keyword">VALUES</span> (<span class=3D"hljs-variabl=
e">@emp_id</span>, <span class=3D"hljs-variable">@name</span>, <span class=
=3D"hljs-variable">@bonus</span>, GETDATE());

    <span class=3D"hljs-comment">-- Fetch next row</span>
    <span class=3D"hljs-keyword">FETCH</span> NEXT <span class=3D"hljs-keyw=
ord">FROM</span> emp_cursor <span class=3D"hljs-keyword">INTO</span> <span =
class=3D"hljs-variable">@emp_id</span>, <span class=3D"hljs-variable">@name=
</span>, <span class=3D"hljs-variable">@salary</span>;
<span class=3D"hljs-keyword">END</span>;

<span class=3D"hljs-comment">-- Step 5: CLOSE and DEALLOCATE</span>
<span class=3D"hljs-keyword">CLOSE</span> emp_cursor;
<span class=3D"hljs-keyword">DEALLOCATE</span> emp_cursor;</code></pre></di=
v>
