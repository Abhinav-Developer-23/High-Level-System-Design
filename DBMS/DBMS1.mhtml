<h4 id=3D"why-use-stored-procedures">Why Use Stored Procedures?</h4>
<div class=3D"tbl"><table>
<thead>
<tr>
<th>Benefit</th>
<th>Explanation</th>
</tr>
</thead>
<tbody>
<tr>
<td><strong>Performance</strong></td>
<td>Precompiled =E2=80=94 no need to parse SQL every time</td>
</tr>
<tr>
<td><strong>Reusability</strong></td>
<td>Write once, call from anywhere</td>
</tr>
<tr>
<td><strong>Security</strong></td>
<td>Users call the procedure without knowing table structure</td>
</tr>
<tr>
<td><strong>Reduced network traffic</strong></td>
<td>One call instead of many queries</td>
</tr>
<tr>
<td><strong>Maintainability</strong></td>
<td>Change logic in one place, all callers benefit</td>
</tr>
</tbody>
</table></div>
<hr>
<h3 id=3D"syntax-1" data-toc=3D"Syntax">Syntax</h3>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-comment">-- Create</span>
<span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keyword">PRO=
CEDURE</span> procedure_name (parameter1 datatype, parameter2 datatype, ...=
)
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-comment">-- SQL statements</span>
<span class=3D"hljs-keyword">END</span>;

<span class=3D"hljs-comment">-- Call</span>
<span class=3D"hljs-keyword">CALL</span> procedure_name(value1, value2, ...=
);

<span class=3D"hljs-comment">-- Drop</span>
<span class=3D"hljs-keyword">DROP</span> <span class=3D"hljs-keyword">PROCE=
DURE</span> procedure_name;</code></pre></div>
<hr>
<h3 id=3D"examples" data-toc=3D"Examples">Examples</h3>
<h4 id=3D"example-1--simple-procedure-no-parameters">Example 1 =E2=80=94 Si=
mple Procedure (No Parameters)</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
d">PROCEDURE</span> GetAllEmployees()
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-keyword">SELECT</span> <span class=3D"hljs-operator=
">*</span> <span class=3D"hljs-keyword">FROM</span> employees;
<span class=3D"hljs-keyword">END</span>;

<span class=3D"hljs-comment">-- Call it</span>
<span class=3D"hljs-keyword">CALL</span> GetAllEmployees();</code></pre></d=
iv>
<h4 id=3D"example-2--procedure-with-input-parameters-in">Example 2 =E2=80=
=94 Procedure with Input Parameters (IN)</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
d">PROCEDURE</span> GetEmployeeByDept(<span class=3D"hljs-keyword">IN</span=
> dept_name <span class=3D"hljs-type">VARCHAR</span>(<span class=3D"hljs-nu=
mber">50</span>))
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-keyword">SELECT</span> emp_id, name, salary
    <span class=3D"hljs-keyword">FROM</span> employees
    <span class=3D"hljs-keyword">WHERE</span> department <span class=3D"hlj=
s-operator">=3D</span> dept_name;
<span class=3D"hljs-keyword">END</span>;

<span class=3D"hljs-comment">-- Call it</span>
<span class=3D"hljs-keyword">CALL</span> GetEmployeeByDept(<span class=3D"h=
ljs-string">&#x27;Engineering&#x27;</span>);</code></pre></div>
<p><strong>Result:</strong></p>
<div class=3D"tbl"><table>
<thead>
<tr>
<th style=3D"text-align:center">emp_id</th>
<th style=3D"text-align:center">name</th>
<th style=3D"text-align:center">salary</th>
</tr>
</thead>
<tbody>
<tr>
<td style=3D"text-align:center">101</td>
<td style=3D"text-align:center">Alice</td>
<td style=3D"text-align:center">75000</td>
</tr>
<tr>
<td style=3D"text-align:center">103</td>
<td style=3D"text-align:center">Carol</td>
<td style=3D"text-align:center">68000</td>
</tr>
</tbody>
</table></div>
<h4 id=3D"example-3--procedure-with-output-parameters-out">Example 3 =E2=80=
=94 Procedure with Output Parameters (OUT)</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
d">PROCEDURE</span> CountEmployees(<span class=3D"hljs-keyword">IN</span> d=
ept_name <span class=3D"hljs-type">VARCHAR</span>(<span class=3D"hljs-numbe=
r">50</span>), <span class=3D"hljs-keyword">OUT</span> emp_count <span clas=
s=3D"hljs-type">INT</span>)
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-keyword">SELECT</span> <span class=3D"hljs-built_in=
">COUNT</span>(<span class=3D"hljs-operator">*</span>) <span class=3D"hljs-=
keyword">INTO</span> emp_count
    <span class=3D"hljs-keyword">FROM</span> employees
    <span class=3D"hljs-keyword">WHERE</span> department <span class=3D"hlj=
s-operator">=3D</span> dept_name;
<span class=3D"hljs-keyword">END</span>;

<span class=3D"hljs-comment">-- Call it</span>
<span class=3D"hljs-keyword">CALL</span> CountEmployees(<span class=3D"hljs=
-string">&#x27;Engineering&#x27;</span>, <span class=3D"hljs-variable">@cou=
nt</span>);
<span class=3D"hljs-keyword">SELECT</span> <span class=3D"hljs-variable">@c=
ount</span>;   <span class=3D"hljs-comment">-- Returns: 2</span></code></pr=
e></div>
<h4 id=3D"example-4--procedure-with-inout-parameter">Example 4 =E2=80=94 Pr=
ocedure with IN/OUT Parameter</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
d">PROCEDURE</span> ApplyRaise(<span class=3D"hljs-keyword">INOUT</span> sa=
lary <span class=3D"hljs-type">DECIMAL</span>(<span class=3D"hljs-number">1=
0</span>,<span class=3D"hljs-number">2</span>), <span class=3D"hljs-keyword=
">IN</span> raise_pct <span class=3D"hljs-type">DECIMAL</span>(<span class=
=3D"hljs-number">5</span>,<span class=3D"hljs-number">2</span>))
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-keyword">SET</span> salary <span class=3D"hljs-oper=
ator">=3D</span> salary <span class=3D"hljs-operator">+</span> (salary <spa=
n class=3D"hljs-operator">*</span> raise_pct <span class=3D"hljs-operator">=
/</span> <span class=3D"hljs-number">100</span>);
<span class=3D"hljs-keyword">END</span>;

<span class=3D"hljs-comment">-- Call it</span>
<span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variable">@sal<=
/span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hljs-number"=
>50000</span>;
<span class=3D"hljs-keyword">CALL</span> ApplyRaise(<span class=3D"hljs-var=
iable">@sal</span>, <span class=3D"hljs-number">10</span>);    <span class=
=3D"hljs-comment">-- 10% raise</span>
<span class=3D"hljs-keyword">SELECT</span> <span class=3D"hljs-variable">@s=
al</span>;                   <span class=3D"hljs-comment">-- Returns: 55000=
.00</span></code></pre></div>
