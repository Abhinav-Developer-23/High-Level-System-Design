<h4 id=3D"spring-boot--jpa-example">Spring Boot / JPA Example</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">Java</span></div><pre><code class=3D=
"hljs"><span class=3D"hljs-meta">@Repository</span>
<span class=3D"hljs-keyword">public</span> <span class=3D"hljs-keyword">int=
erface</span> <span class=3D"hljs-title class_">MessageRepository</span> <s=
pan class=3D"hljs-keyword">extends</span> <span class=3D"hljs-title class_"=
>JpaRepository</span>&lt;Message, String&gt; {

    <span class=3D"hljs-comment">// First page (no cursor)</span>
    <span class=3D"hljs-meta">@Query(&quot;SELECT m FROM Message m WHERE m.=
conversationId =3D :convId ORDER BY m.messageId DESC&quot;)</span>
    List&lt;Message&gt; <span class=3D"hljs-title function_">findFirstPage<=
/span><span class=3D"hljs-params">(<span class=3D"hljs-meta">@Param(&quot;c=
onvId&quot;)</span> String convId, Pageable pageable)</span>;

    <span class=3D"hljs-comment">// Next page (with cursor)</span>
    <span class=3D"hljs-meta">@Query(&quot;SELECT m FROM Message m WHERE m.=
conversationId =3D :convId AND m.messageId &lt; :cursor ORDER BY m.messageI=
d DESC&quot;)</span>
    List&lt;Message&gt; <span class=3D"hljs-title function_">findNextPage</=
span><span class=3D"hljs-params">(<span class=3D"hljs-meta">@Param(&quot;co=
nvId&quot;)</span> String convId, <span class=3D"hljs-meta">@Param(&quot;cu=
rsor&quot;)</span> String cursor, Pageable pageable)</span>;
}</code></pre></div>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">Java</span></div><pre><code class=3D=
"hljs"><span class=3D"hljs-meta">@Service</span>
<span class=3D"hljs-keyword">public</span> <span class=3D"hljs-keyword">cla=
ss</span> <span class=3D"hljs-title class_">MessageService</span> {

    <span class=3D"hljs-meta">@Autowired</span>
    <span class=3D"hljs-keyword">private</span> MessageRepository messageRe=
pository;

    <span class=3D"hljs-keyword">public</span> CursorPage&lt;Message&gt; <s=
pan class=3D"hljs-title function_">getMessages</span><span class=3D"hljs-pa=
rams">(String conversationId, String cursor, <span class=3D"hljs-type">int<=
/span> limit)</span> {
        List&lt;Message&gt; messages;

        <span class=3D"hljs-keyword">if</span> (cursor =3D=3D <span class=
=3D"hljs-literal">null</span>) {
            messages =3D messageRepository.findFirstPage(conversationId, Pa=
geRequest.of(<span class=3D"hljs-number">0</span>, limit));
        } <span class=3D"hljs-keyword">else</span> {
            <span class=3D"hljs-type">String</span> <span class=3D"hljs-var=
iable">decodedCursor</span> <span class=3D"hljs-operator">=3D</span> decode=
Cursor(cursor);  <span class=3D"hljs-comment">// base64 =E2=86=92 msg_id</s=
pan>
            messages =3D messageRepository.findNextPage(conversationId, dec=
odedCursor, PageRequest.of(<span class=3D"hljs-number">0</span>, limit));
        }

        <span class=3D"hljs-type">String</span> <span class=3D"hljs-variabl=
e">nextCursor</span> <span class=3D"hljs-operator">=3D</span> messages.size=
() =3D=3D limit
            ? encodeCursor(messages.get(messages.size() - <span class=3D"hl=
js-number">1</span>).getMessageId())  <span class=3D"hljs-comment">// last =
item&#x27;s ID</span>
            : <span class=3D"hljs-literal">null</span>;

        <span class=3D"hljs-keyword">return</span> <span class=3D"hljs-keyw=
ord">new</span> <span class=3D"hljs-title class_">CursorPage</span>&lt;&gt;=
(messages, nextCursor, messages.size() =3D=3D limit);
    }
}</code></pre></div>
<blockquote>
<p>=F0=9F=94=97 Do not confuse this with a <strong>SQL cursor</strong> (<co=
de>DECLARE ... CURSOR</code>), which is a
server-side row-by-row iteration feature. See <a href=3D"#cursor-in-sql">Cu=
rsor in SQL</a>.</p>
</blockquote>
