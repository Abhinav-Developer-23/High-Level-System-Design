<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-comment">-- MySQL</span>
<span class=3D"hljs-keyword">SHOW</span> <span class=3D"hljs-keyword">FULL<=
/span> TABLES <span class=3D"hljs-keyword">WHERE</span> table_type <span cl=
ass=3D"hljs-keyword">LIKE</span> <span class=3D"hljs-string">&#x27;%VIEW&#x=
