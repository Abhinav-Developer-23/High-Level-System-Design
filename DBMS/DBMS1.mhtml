=3D"hljs-keyword">WHERE</span> customer_id <span class=3D"hljs-operator">=
=3D</span> <span class=3D"hljs-number">42</span> <span class=3D"hljs-keywor=
d">ORDER</span> <span class=3D"hljs-keyword">BY</span> created_at <span cla=
ss=3D"hljs-keyword">DESC</span> LIMIT <span class=3D"hljs-number">20</span>=
;</code></pre></div>
