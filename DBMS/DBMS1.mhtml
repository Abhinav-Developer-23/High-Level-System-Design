<p>This forms a <strong>sliding window</strong> =E2=80=94 at any given time=
, the table holds exactly 7 days of data.</p>
<h4 id=3D"complete-working-example--7-day-retention">Complete Working Examp=
le =E2=80=94 7-Day Retention</h4>
<p><strong>Step 1: Create the table with daily partitions</strong></p>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
d">TABLE</span> events (
    id          <span class=3D"hljs-type">BIGINT</span> AUTO_INCREMENT,
    event_type  <span class=3D"hljs-type">VARCHAR</span>(<span class=3D"hlj=
s-number">50</span>),
    payload     JSON,
    created_at  <span class=3D"hljs-type">DATE</span> <span class=3D"hljs-k=
eyword">NOT</span> <span class=3D"hljs-keyword">NULL</span>,
    <span class=3D"hljs-keyword">PRIMARY</span> KEY (id, created_at)       =
<span class=3D"hljs-comment">-- Partition key must be in the PK</span>
) <span class=3D"hljs-keyword">PARTITION</span> <span class=3D"hljs-keyword=
">BY</span> <span class=3D"hljs-keyword">RANGE</span> (TO_DAYS(created_at))=
 (
    <span class=3D"hljs-keyword">PARTITION</span> p20250218 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-19&#x27;</span>)),
    <span class=3D"hljs-keyword">PARTITION</span> p20250219 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-20&#x27;</span>)),
    <span class=3D"hljs-keyword">PARTITION</span> p20250220 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-21&#x27;</span>)),
    <span class=3D"hljs-keyword">PARTITION</span> p20250221 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-22&#x27;</span>)),
    <span class=3D"hljs-keyword">PARTITION</span> p20250222 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-23&#x27;</span>)),
    <span class=3D"hljs-keyword">PARTITION</span> p20250223 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-24&#x27;</span>)),
    <span class=3D"hljs-keyword">PARTITION</span> p20250224 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-25&#x27;</span>)),  <span class=3D"hljs-comment">-- today</sp=
an>
    <span class=3D"hljs-keyword">PARTITION</span> p20250225 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-26&#x27;</span>)),  <span class=3D"hljs-comment">-- tomorrow =
(pre-created)</span>
    <span class=3D"hljs-keyword">PARTITION</span> p_future  <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN MAXVALUE                  <span class=
=3D"hljs-comment">-- safety net</span>
);</code></pre></div>
<div class=3D"markdown-alert markdown-alert-note"><p class=3D"markdown-aler=
t-title"><svg class=3D"octicon octicon-info mr-2" viewBox=3D"0 0 16 16" ver=
sion=3D"1.1" width=3D"16" height=3D"16" aria-hidden=3D"true"><path d=3D"M0 =
8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13=
ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 =
0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1=
 0-2 1 1 0 0 1 0 2Z"></path></svg>Note</p><p><code>TO_DAYS()</code> convert=
s a date to an integer (number of days since year 0). MySQL requires intege=
r expressions for <code>RANGE</code> partitioning, so we can't use a <code>=
DATE</code> value directly =E2=80=94 <code>TO_DAYS()</code> bridges that ga=
p.</p>
</div>
<p><strong>Step 2: Daily rotation =E2=80=94 drop the oldest, add a new futu=
re partition</strong></p>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-comment">-- Run this every day at midnight (via a=
 cron job or scheduled event)</span>

<span class=3D"hljs-comment">-- 1. Drop the partition that is now 7+ days o=
ld</span>
<span class=3D"hljs-keyword">ALTER</span> <span class=3D"hljs-keyword">TABL=
E</span> events <span class=3D"hljs-keyword">DROP</span> <span class=3D"hlj=
s-keyword">PARTITION</span> p20250218;
<span class=3D"hljs-comment">-- =F0=9F=92=A5 Millions of rows deleted INSTA=
NTLY =E2=80=94 no row-by-row scanning</span>

<span class=3D"hljs-comment">-- 2. Reorganize the future partition to add t=
omorrow&#x27;s dedicated partition</span>
<span class=3D"hljs-keyword">ALTER</span> <span class=3D"hljs-keyword">TABL=
E</span> events REORGANIZE <span class=3D"hljs-keyword">PARTITION</span> p_=
future <span class=3D"hljs-keyword">INTO</span> (
    <span class=3D"hljs-keyword">PARTITION</span> p20250226 <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN (TO_DAYS(<span class=3D"hljs-string">=
&#x27;2025-02-27&#x27;</span>)),
    <span class=3D"hljs-keyword">PARTITION</span> p_future  <span class=3D"=
hljs-keyword">VALUES</span> LESS THAN MAXVALUE
);</code></pre></div>
<div class=3D"markdown-alert markdown-alert-note"><p class=3D"markdown-aler=
t-title"><svg class=3D"octicon octicon-info mr-2" viewBox=3D"0 0 16 16" ver=
sion=3D"1.1" width=3D"16" height=3D"16" aria-hidden=3D"true"><path d=3D"M0 =
8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13=
ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 =
0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1=
 0-2 1 1 0 0 1 0 2Z"></path></svg>Note</p><p><strong>Why <code>REORGANIZE</=
code> instead of <code>ADD</code>?</strong> Since <code>p_future</code> alr=
eady catches everything beyond the last named partition, you can't just <co=
de>ADD PARTITION</code> (MySQL would complain about overlapping ranges). <c=
ode>REORGANIZE PARTITION</code> splits <code>p_future</code> into the new d=
ay's partition plus a new <code>p_future</code>.</p>
</div>
<p><strong>Step 3: Automate with a MySQL Event (built-in cron)</strong></p>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs">DELIMITER <span class=3D"hljs-operator">/</span><span class=3D"hljs-o=
perator">/</span>

<span class=3D"hljs-keyword">CREATE</span> EVENT rotate_events_daily
<span class=3D"hljs-keyword">ON</span> SCHEDULE <span class=3D"hljs-keyword=
">EVERY</span> <span class=3D"hljs-number">1</span> <span class=3D"hljs-key=
word">DAY</span>
STARTS <span class=3D"hljs-string">&#x27;2025-02-25 00:05:00&#x27;</span>  =
  <span class=3D"hljs-comment">-- runs at 12:05 AM daily</span>
DO
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-comment">-- Calculate partition names</span>
    <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variable">@=
old_date</span> <span class=3D"hljs-operator">=3D</span> DATE_FORMAT(DATE_S=
UB(CURDATE(), <span class=3D"hljs-type">INTERVAL</span> <span class=3D"hljs=
-number">7</span> <span class=3D"hljs-keyword">DAY</span>), <span class=3D"=
hljs-string">&#x27;%Y%m%d&#x27;</span>);
    <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variable">@=
new_date</span> <span class=3D"hljs-operator">=3D</span> DATE_FORMAT(DATE_A=
DD(CURDATE(), <span class=3D"hljs-type">INTERVAL</span> <span class=3D"hljs=
-number">1</span> <span class=3D"hljs-keyword">DAY</span>), <span class=3D"=
hljs-string">&#x27;%Y%m%d&#x27;</span>);
    <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variable">@=
new_boundary</span> <span class=3D"hljs-operator">=3D</span> DATE_FORMAT(DA=
TE_ADD(CURDATE(), <span class=3D"hljs-type">INTERVAL</span> <span class=3D"=
hljs-number">2</span> <span class=3D"hljs-keyword">DAY</span>), <span class=
=3D"hljs-string">&#x27;%Y-%m-%d&#x27;</span>);

    <span class=3D"hljs-comment">-- Drop old partition</span>
    <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variable">@=
drop_sql</span> <span class=3D"hljs-operator">=3D</span> CONCAT(<span class=
=3D"hljs-string">&#x27;ALTER TABLE events DROP PARTITION p&#x27;</span>, <s=
pan class=3D"hljs-variable">@old_date</span>);
    <span class=3D"hljs-keyword">PREPARE</span> stmt <span class=3D"hljs-ke=
yword">FROM</span> <span class=3D"hljs-variable">@drop_sql</span>;
    <span class=3D"hljs-keyword">EXECUTE</span> stmt;
    <span class=3D"hljs-keyword">DEALLOCATE</span> <span class=3D"hljs-keyw=
ord">PREPARE</span> stmt;

    <span class=3D"hljs-comment">-- Add new partition</span>
    <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-variable">@=
add_sql</span> <span class=3D"hljs-operator">=3D</span> CONCAT(
        <span class=3D"hljs-string">&#x27;ALTER TABLE events REORGANIZE PAR=
TITION p_future INTO (&#x27;</span>,
        <span class=3D"hljs-string">&#x27;PARTITION p&#x27;</span>, <span c=
lass=3D"hljs-variable">@new_date</span>, <span class=3D"hljs-string">&#x27;=
 VALUES LESS THAN (TO_DAYS(&#x27;&#x27;&#x27;</span>, <span class=3D"hljs-v=
ariable">@new_boundary</span>, <span class=3D"hljs-string">&#x27;&#x27;&#x2=
7;)), &#x27;</span>,
        <span class=3D"hljs-string">&#x27;PARTITION p_future VALUES LESS TH=
AN MAXVALUE)&#x27;</span>
    );
    <span class=3D"hljs-keyword">PREPARE</span> stmt <span class=3D"hljs-ke=
yword">FROM</span> <span class=3D"hljs-variable">@add_sql</span>;
    <span class=3D"hljs-keyword">EXECUTE</span> stmt;
    <span class=3D"hljs-keyword">DEALLOCATE</span> <span class=3D"hljs-keyw=
ord">PREPARE</span> stmt;
<span class=3D"hljs-keyword">END</span> <span class=3D"hljs-operator">/</sp=
an><span class=3D"hljs-operator">/</span>

DELIMITER ;

<span class=3D"hljs-comment">-- Don&#x27;t forget to enable the event sched=
uler</span>
<span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-keyword">GLOBAL=
</span> event_scheduler <span class=3D"hljs-operator">=3D</span> <span clas=
s=3D"hljs-keyword">ON</span>;</code></pre></div>
