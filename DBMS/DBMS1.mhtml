ondition</span>
<span class=3D"hljs-keyword">SELECT</span> quantity <span class=3D"hljs-key=
word">FROM</span> products <span class=3D"hljs-keyword">WHERE</span> produc=
t_id <span class=3D"hljs-operator">=3D</span> <span class=3D"hljs-number">1=
01</span>;  <span class=3D"hljs-comment">-- App reads 10</span>
<span class=3D"hljs-comment">-- Another transaction could change it here!</=
span>
