</tr>
<tr>
<td style=3D"text-align:center">1</td>
<td>Debit Alice</td>
<td style=3D"text-align:center"><strong>500</strong></td>
<td style=3D"text-align:center">2000</td>
<td style=3D"text-align:center">In memory</td>
</tr>
<tr>
<td style=3D"text-align:center">2</td>
<td>Credit Bob</td>
<td style=3D"text-align:center">500</td>
<td style=3D"text-align:center">=E2=9D=8C ERROR</td>
<td style=3D"text-align:center">Bob's account frozen</td>
</tr>
<tr>
