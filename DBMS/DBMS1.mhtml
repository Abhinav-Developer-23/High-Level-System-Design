hljs"><span class=3D"hljs-comment">-- Grant with the ability to pass on the=
 privilege to others</span>
<span class=3D"hljs-keyword">GRANT</span> <span class=3D"hljs-keyword">SELE=
CT</span> <span class=3D"hljs-keyword">ON</span> employees <span class=3D"h=
ljs-keyword">TO</span> team_lead <span class=3D"hljs-keyword">WITH</span> <=
span class=3D"hljs-keyword">GRANT</span> OPTION;</code></pre></div>
