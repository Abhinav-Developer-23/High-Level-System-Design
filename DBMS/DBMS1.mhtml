or">*</span> <span class=3D"hljs-keyword">FROM</span> users <span class=3D"=
hljs-keyword">WHERE</span> email <span class=3D"hljs-operator">=3D</span> <=
span class=3D"hljs-string">&#x27;alice@example.com&#x27;</span>;

<span class=3D"hljs-comment">-- Step 1: Walk the SECONDARY index (email) =
=E2=86=92 find PK =3D 42</span>
<span class=3D"hljs-comment">-- Step 2: Walk the CLUSTERED index (id) =E2=
=86=92 find id =3D 42 =E2=86=92 read full row</span>
<span class=3D"hljs-comment">-- Total: 2 B+ Tree traversals</span></code></=
pre></div>
