<h3 id=3D"basic-syntax" data-toc=3D"Basic Syntax">Basic Syntax</h3>
<h4 id=3D"mysql-syntax">MySQL Syntax</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">DECLARE</span> cursor_name <span class=
=3D"hljs-keyword">CURSOR</span> <span class=3D"hljs-keyword">FOR</span>
    <span class=3D"hljs-keyword">SELECT</span> column1, column2 <span class=
=3D"hljs-keyword">FROM</span> table_name <span class=3D"hljs-keyword">WHERE=
</span> <span class=3D"hljs-keyword">condition</span>;

<span class=3D"hljs-keyword">DECLARE</span> CONTINUE HANDLER <span class=3D=
"hljs-keyword">FOR</span> <span class=3D"hljs-keyword">NOT</span> FOUND <sp=
an class=3D"hljs-keyword">SET</span> done <span class=3D"hljs-operator">=3D=
</span> <span class=3D"hljs-number">1</span>;

<span class=3D"hljs-keyword">OPEN</span> cursor_name;

read_loop: LOOP
    <span class=3D"hljs-keyword">FETCH</span> cursor_name <span class=3D"hl=
js-keyword">INTO</span> <span class=3D"hljs-variable">@var1</span>, <span c=
lass=3D"hljs-variable">@var2</span>;
    IF done <span class=3D"hljs-keyword">THEN</span>
        LEAVE read_loop;
    <span class=3D"hljs-keyword">END</span> IF;
    <span class=3D"hljs-comment">-- Process each row here</span>
<span class=3D"hljs-keyword">END</span> LOOP;

<span class=3D"hljs-keyword">CLOSE</span> cursor_name;</code></pre></div>
<h4 id=3D"sql-server-syntax">SQL Server Syntax</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">DECLARE</span> cursor_name <span class=
=3D"hljs-keyword">CURSOR</span> <span class=3D"hljs-keyword">FOR</span>
    <span class=3D"hljs-keyword">SELECT</span> column1, column2 <span class=
=3D"hljs-keyword">FROM</span> table_name <span class=3D"hljs-keyword">WHERE=
</span> <span class=3D"hljs-keyword">condition</span>;

<span class=3D"hljs-keyword">OPEN</span> cursor_name;

<span class=3D"hljs-keyword">FETCH</span> NEXT <span class=3D"hljs-keyword"=
>FROM</span> cursor_name <span class=3D"hljs-keyword">INTO</span> <span cla=
ss=3D"hljs-variable">@var1</span>, <span class=3D"hljs-variable">@var2</spa=
n>;

WHILE @<span class=3D"hljs-variable">@FETCH_STATUS</span> <span class=3D"hl=
js-operator">=3D</span> <span class=3D"hljs-number">0</span>
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-comment">-- Process each row here</span>
    <span class=3D"hljs-keyword">FETCH</span> NEXT <span class=3D"hljs-keyw=
ord">FROM</span> cursor_name <span class=3D"hljs-keyword">INTO</span> <span=
 class=3D"hljs-variable">@var1</span>, <span class=3D"hljs-variable">@var2<=
/span>;
<span class=3D"hljs-keyword">END</span>;

<span class=3D"hljs-keyword">CLOSE</span> cursor_name;
<span class=3D"hljs-keyword">DEALLOCATE</span> cursor_name;</code></pre></d=
iv>
