<h4 id=3D"acid-summary-table">ACID Summary Table</h4>
<div class=3D"tbl"><table>
<thead>
<tr>
<th style=3D"text-align:center">Property</th>
<th>Meaning</th>
<th>Ensures</th>
<th style=3D"text-align:center">Responsibility</th>
<th>Managed By (DBMS component)</th>
</tr>
</thead>
<tbody>
<tr>
<td style=3D"text-align:center"><strong>Atomicity</strong></td>
<td>All or nothing</td>
<td>No partial transactions</td>
<td style=3D"text-align:center">DBMS</td>
<td>Transaction Manager + Undo Log</td>
</tr>
<tr>
<td style=3D"text-align:center"><strong>Consistency</strong></td>
<td>Valid state =E2=86=92 Valid state</td>
<td>Integrity constraints hold</td>
<td style=3D"text-align:center">Developer + DBMS</td>
<td>Application logic + Constraints</td>
</tr>
<tr>
<td style=3D"text-align:center"><strong>Isolation</strong></td>
<td>Transactions don't interfere</td>
<td>Concurrent =3D Serial result</td>
<td style=3D"text-align:center">DBMS</td>
<td>Concurrency Control Manager (Locks/MVCC)</td>
</tr>
<tr>
<td style=3D"text-align:center"><strong>Durability</strong></td>
<td>Committed =3D Permanent</td>
<td>Survives crashes</td>
<td style=3D"text-align:center">DBMS</td>
<td>Recovery Manager + WAL (Redo Log)</td>
</tr>
</tbody>
</table></div>
