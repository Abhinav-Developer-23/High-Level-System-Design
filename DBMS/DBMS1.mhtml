    emp_id   <span class=3D"hljs-type">INT</span> <span class=3D"hljs-keywo=
rd">PRIMARY</span> KEY,                              <span class=3D"hljs-co=
mment">-- Entity Integrity</span>
    name     <span class=3D"hljs-type">VARCHAR</span>(<span class=3D"hljs-n=
umber">50</span>) <span class=3D"hljs-keyword">NOT</span> <span class=3D"hl=
js-keyword">NULL</span>,                         <span class=3D"hljs-commen=
t">-- Domain Integrity</span>
    age      <span class=3D"hljs-type">INT</span> <span class=3D"hljs-keywo=
rd">CHECK</span> (age <span class=3D"hljs-keyword">BETWEEN</span> <span cla=
ss=3D"hljs-number">18</span> <span class=3D"hljs-keyword">AND</span> <span =
class=3D"hljs-number">65</span>),            <span class=3D"hljs-comment">-=
- Domain Integrity</span>
    salary   <span class=3D"hljs-type">DECIMAL</span>(<span class=3D"hljs-n=
umber">10</span>,<span class=3D"hljs-number">2</span>) <span class=3D"hljs-=
keyword">CHECK</span> (salary <span class=3D"hljs-operator">&gt;</span> <sp=
an class=3D"hljs-number">0</span>),             <span class=3D"hljs-comment=
">-- Domain Integrity</span>
    dept_id  <span class=3D"hljs-type">INT</span>,
    <span class=3D"hljs-keyword">FOREIGN</span> KEY (dept_id) <span class=
=3D"hljs-keyword">REFERENCES</span> departments(dept_id)  <span class=3D"hl=
js-comment">-- Referential Integrity</span>
);</code></pre></div>
