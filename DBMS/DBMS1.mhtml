<h3 id=3D"variables--control-flow" data-toc=3D"Variables &amp; Control Flow=
">Variables &amp; Control Flow</h3>
<h4 id=3D"variables">Variables</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
d">PROCEDURE</span> CalculateBonus(<span class=3D"hljs-keyword">IN</span> e=
mp_id <span class=3D"hljs-type">INT</span>)
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-keyword">DECLARE</span> base_salary <span class=3D"=
hljs-type">DECIMAL</span>(<span class=3D"hljs-number">10</span>,<span class=
=3D"hljs-number">2</span>);
    <span class=3D"hljs-keyword">DECLARE</span> bonus <span class=3D"hljs-t=
ype">DECIMAL</span>(<span class=3D"hljs-number">10</span>,<span class=3D"hl=
js-number">2</span>);

    <span class=3D"hljs-keyword">SELECT</span> salary <span class=3D"hljs-k=
eyword">INTO</span> base_salary <span class=3D"hljs-keyword">FROM</span> em=
ployees <span class=3D"hljs-keyword">WHERE</span> id <span class=3D"hljs-op=
erator">=3D</span> emp_id;
    <span class=3D"hljs-keyword">SET</span> bonus <span class=3D"hljs-opera=
tor">=3D</span> base_salary <span class=3D"hljs-operator">*</span> <span cl=
ass=3D"hljs-number">0.10</span>;

    <span class=3D"hljs-keyword">SELECT</span> emp_id, base_salary, bonus;
<span class=3D"hljs-keyword">END</span>;</code></pre></div>
<h4 id=3D"if-else">IF-ELSE</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
