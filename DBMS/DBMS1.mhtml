<h3 id=3D"tcl-commands--quick-reference" data-toc=3D"TCL Commands =E2=80=94=
 Quick Reference">TCL Commands =E2=80=94 Quick Reference</h3>
<div class=3D"tbl"><table>
<thead>
<tr>
<th>Command</th>
<th>What It Does</th>
<th style=3D"text-align:center">Can Undo?</th>
</tr>
</thead>
<tbody>
<tr>
<td><code>BEGIN TRANSACTION</code></td>
<td>Start a new transaction</td>
<td style=3D"text-align:center">=E2=80=94</td>
</tr>
<tr>
<td><code>COMMIT</code></td>
<td>Make all changes permanent</td>
<td style=3D"text-align:center">=E2=9D=8C Cannot undo after commit</td>
</tr>
<tr>
<td><code>ROLLBACK</code></td>
<td>Undo ALL changes since BEGIN</td>
<td style=3D"text-align:center">=E2=9C=85 Restores original state</td>
</tr>
<tr>
<td><code>SAVEPOINT name</code></td>
<td>Create a checkpoint</td>
<td style=3D"text-align:center">=E2=80=94</td>
</tr>
<tr>
<td><code>ROLLBACK TO name</code></td>
<td>Undo changes back to checkpoint</td>
<td style=3D"text-align:center">=E2=9C=85 Partial undo</td>
</tr>
<tr>
<td><code>RELEASE SAVEPOINT name</code></td>
<td>Delete a savepoint</td>
<td style=3D"text-align:center">=E2=80=94</td>
</tr>
</tbody>
</table></div>
<hr>
