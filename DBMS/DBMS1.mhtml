<h4 id=3D"multiple-savepoints">Multiple Savepoints</h4>
<p>You can create multiple savepoints within a single transaction:</p>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">BEGIN</span> TRANSACTION;

<span class=3D"hljs-keyword">INSERT</span> <span class=3D"hljs-keyword">INT=
O</span> orders <span class=3D"hljs-keyword">VALUES</span> (<span class=3D"=
hljs-number">1</span>, <span class=3D"hljs-string">&#x27;Laptop&#x27;</span=
>, <span class=3D"hljs-number">50000</span>);
<span class=3D"hljs-keyword">SAVEPOINT</span> sp1;

<span class=3D"hljs-keyword">INSERT</span> <span class=3D"hljs-keyword">INT=
O</span> orders <span class=3D"hljs-keyword">VALUES</span> (<span class=3D"=
hljs-number">2</span>, <span class=3D"hljs-string">&#x27;Mouse&#x27;</span>=
, <span class=3D"hljs-number">500</span>);
<span class=3D"hljs-keyword">SAVEPOINT</span> sp2;

<span class=3D"hljs-keyword">INSERT</span> <span class=3D"hljs-keyword">INT=
O</span> orders <span class=3D"hljs-keyword">VALUES</span> (<span class=3D"=
hljs-number">3</span>, <span class=3D"hljs-string">&#x27;Keyboard&#x27;</sp=
an>, <span class=3D"hljs-number">1500</span>);
<span class=3D"hljs-keyword">SAVEPOINT</span> sp3;

<span class=3D"hljs-comment">-- Oops, keyboard order was wrong</span>
<span class=3D"hljs-keyword">ROLLBACK</span> <span class=3D"hljs-keyword">T=
O</span> sp2;   <span class=3D"hljs-comment">-- Undoes order #3 only</span>

<span class=3D"hljs-comment">-- Mouse order was also wrong</span>
<span class=3D"hljs-keyword">ROLLBACK</span> <span class=3D"hljs-keyword">T=
O</span> sp1;   <span class=3D"hljs-comment">-- Undoes order #2 as well</sp=
an>

<span class=3D"hljs-keyword">COMMIT</span>;   <span class=3D"hljs-comment">=
-- Only order #1 (Laptop) is saved!</span></code></pre></div>
