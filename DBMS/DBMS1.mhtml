<h3 id=3D"types-of-cursors" data-toc=3D"Types of Cursors">Types of Cursors<=
/h3>
<div class=3D"tbl"><table>
<thead>
<tr>
<th style=3D"text-align:center">Type</th>
<th>Description</th>
<th>Use Case</th>
</tr>
</thead>
<tbody>
<tr>
<td style=3D"text-align:center"><strong>Forward-only</strong></td>
<td>Can only move forward (FETCH NEXT)</td>
<td>Most common, fastest</td>
</tr>
<tr>
<td style=3D"text-align:center"><strong>Scrollable</strong></td>
<td>Can move forward, backward, or to any position</td>
<td>When you need random access</td>
</tr>
<tr>
<td style=3D"text-align:center"><strong>Static</strong></td>
<td>Works on a snapshot =E2=80=94 changes to base data aren't reflected</td=
>
<td>When you need a frozen copy</td>
</tr>
<tr>
<td style=3D"text-align:center"><strong>Dynamic</strong></td>
<td>Reflects real-time changes to the base data</td>
<td>When you need live data</td>
</tr>
<tr>
<td style=3D"text-align:center"><strong>Keyset</strong></td>
<td>Middle ground =E2=80=94 structure is fixed, values can change</td>
<td>Moderate performance</td>
</tr>
</tbody>
</table></div>
<h4 id=3D"declaring-scrollable-cursor-sql-server">Declaring Scrollable Curs=
or (SQL Server)</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">DECLARE</span> scroll_cursor <span class=
=3D"hljs-keyword">SCROLL</span> <span class=3D"hljs-keyword">CURSOR</span> =
<span class=3D"hljs-keyword">FOR</span>
    <span class=3D"hljs-keyword">SELECT</span> emp_id, name <span class=3D"=
hljs-keyword">FROM</span> employees;

<span class=3D"hljs-keyword">OPEN</span> scroll_cursor;

<span class=3D"hljs-keyword">FETCH</span> <span class=3D"hljs-keyword">FIRS=
T</span>   <span class=3D"hljs-keyword">FROM</span> scroll_cursor <span cla=
ss=3D"hljs-keyword">INTO</span> <span class=3D"hljs-variable">@id</span>, <=
span class=3D"hljs-variable">@name</span>;  <span class=3D"hljs-comment">--=
 First row</span>
<span class=3D"hljs-keyword">FETCH</span> <span class=3D"hljs-keyword">LAST=
</span>    <span class=3D"hljs-keyword">FROM</span> scroll_cursor <span cla=
ss=3D"hljs-keyword">INTO</span> <span class=3D"hljs-variable">@id</span>, <=
span class=3D"hljs-variable">@name</span>;  <span class=3D"hljs-comment">--=
 Last row</span>
<span class=3D"hljs-keyword">FETCH</span> NEXT    <span class=3D"hljs-keywo=
rd">FROM</span> scroll_cursor <span class=3D"hljs-keyword">INTO</span> <spa=
n class=3D"hljs-variable">@id</span>, <span class=3D"hljs-variable">@name</=
span>;  <span class=3D"hljs-comment">-- Next row</span>
<span class=3D"hljs-keyword">FETCH</span> PRIOR   <span class=3D"hljs-keywo=
rd">FROM</span> scroll_cursor <span class=3D"hljs-keyword">INTO</span> <spa=
n class=3D"hljs-variable">@id</span>, <span class=3D"hljs-variable">@name</=
span>;  <span class=3D"hljs-comment">-- Previous row</span>
<span class=3D"hljs-keyword">FETCH</span> ABSOLUTE <span class=3D"hljs-numb=
er">5</span> <span class=3D"hljs-keyword">FROM</span> scroll_cursor <span c=
lass=3D"hljs-keyword">INTO</span> <span class=3D"hljs-variable">@id</span>,=
 <span class=3D"hljs-variable">@name</span>; <span class=3D"hljs-comment">-=
- 5th row</span>

<span class=3D"hljs-keyword">CLOSE</span> scroll_cursor;
<span class=3D"hljs-keyword">DEALLOCATE</span> scroll_cursor;</code></pre><=
/div>
