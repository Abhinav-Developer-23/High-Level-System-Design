<th>state</th>
<th>zip_code</th>
</tr>
</thead>
<tbody>
<tr>
<td><em>(structure only =E2=80=94 column definitions, no data)</em></td>
<td></td>
<td></td>
<td></td>
<td></td>
<td></td>
</tr>
</tbody>
</table></div>
<p><strong>DISCOUNTS table schema:</strong></p>
<div class=3D"tbl"><table>
