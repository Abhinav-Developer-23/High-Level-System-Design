<h3 id=3D"parameter-types" data-toc=3D"Parameter Types">Parameter Types</h3=
>
<div class=3D"tbl"><table>
<thead>
<tr>
<th style=3D"text-align:center">Type</th>
<th style=3D"text-align:center">Direction</th>
<th>Description</th>
</tr>
</thead>
<tbody>
<tr>
<td style=3D"text-align:center"><code>IN</code></td>
<td style=3D"text-align:center">Caller =E2=86=92 Procedure</td>
<td>Input value (default if not specified)</td>
</tr>
<tr>
<td style=3D"text-align:center"><code>OUT</code></td>
<td style=3D"text-align:center">Procedure =E2=86=92 Caller</td>
<td>Output value returned to the caller</td>
</tr>
<tr>
<td style=3D"text-align:center"><code>INOUT</code></td>
<td style=3D"text-align:center">Both ways</td>
<td>Input that gets modified and returned</td>
</tr>
</tbody>
</table></div>
