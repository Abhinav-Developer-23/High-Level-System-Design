 <span class=3D"hljs-type">INT</span>, <span class=3D"hljs-keyword">OUT</sp=
an> <span class=3D"hljs-keyword">result</span> <span class=3D"hljs-type">VA=
RCHAR</span>(<span class=3D"hljs-number">10</span>))
<span class=3D"hljs-keyword">BEGIN</span>
    IF marks <span class=3D"hljs-operator">&gt;=3D</span> <span class=3D"hl=
js-number">90</span> <span class=3D"hljs-keyword">THEN</span>
        <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-keyword=
">result</span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hlj=
s-string">&#x27;A&#x27;</span>;
    ELSEIF marks <span class=3D"hljs-operator">&gt;=3D</span> <span class=
=3D"hljs-number">75</span> <span class=3D"hljs-keyword">THEN</span>
        <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-keyword=
">result</span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hlj=
s-string">&#x27;B&#x27;</span>;
    ELSEIF marks <span class=3D"hljs-operator">&gt;=3D</span> <span class=
=3D"hljs-number">60</span> <span class=3D"hljs-keyword">THEN</span>
        <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-keyword=
">result</span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hlj=
s-string">&#x27;C&#x27;</span>;
    <span class=3D"hljs-keyword">ELSE</span>
        <span class=3D"hljs-keyword">SET</span> <span class=3D"hljs-keyword=
">result</span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hlj=
s-string">&#x27;FAIL&#x27;</span>;
    <span class=3D"hljs-keyword">END</span> IF;
<span class=3D"hljs-keyword">END</span>;</code></pre></div>
<h4 id=3D"loop--while">LOOP / WHILE</h4>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keywor=
d">PROCEDURE</span> InsertNumbers()
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-keyword">DECLARE</span> i <span class=3D"hljs-type"=
>INT</span> <span class=3D"hljs-keyword">DEFAULT</span> <span class=3D"hljs=
-number">1</span>;
    WHILE i <span class=3D"hljs-operator">&lt;=3D</span> <span class=3D"hlj=
s-number">10</span> DO
        <span class=3D"hljs-keyword">INSERT</span> <span class=3D"hljs-keyw=
ord">INTO</span> numbers_table (num) <span class=3D"hljs-keyword">VALUES</s=
pan> (i);
        <span class=3D"hljs-keyword">SET</span> i <span class=3D"hljs-opera=
tor">=3D</span> i <span class=3D"hljs-operator">+</span> <span class=3D"hlj=
s-number">1</span>;
    <span class=3D"hljs-keyword">END</span> WHILE;
<span class=3D"hljs-keyword">END</span>;</code></pre></div>
