<h3 id=3D"mysql-cursors--specifics--limitations" data-toc=3D"MySQL Cursors =
=E2=80=94 Specifics &amp; Limitations">MySQL Cursors =E2=80=94 Specifics &a=
mp; Limitations</h3>
<p>MySQL has a built-in <code>CURSOR</code> keyword for use inside <strong>=
stored procedures</strong>. It lets you iterate over a result set <strong>r=
ow by row</strong>, similar to a for-each loop in application code.</p>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs">DELIMITER <span class=3D"hljs-operator">/</span><span class=3D"hljs-o=
perator">/</span>
<span class=3D"hljs-keyword">CREATE</span> <span class=3D"hljs-keyword">PRO=
CEDURE</span> process_pending_messages()
<span class=3D"hljs-keyword">BEGIN</span>
    <span class=3D"hljs-keyword">DECLARE</span> done <span class=3D"hljs-ty=
pe">INT</span> <span class=3D"hljs-keyword">DEFAULT</span> <span class=3D"h=
ljs-literal">FALSE</span>;
    <span class=3D"hljs-keyword">DECLARE</span> msg_id <span class=3D"hljs-=
type">VARCHAR</span>(<span class=3D"hljs-number">50</span>);
    <span class=3D"hljs-keyword">DECLARE</span> msg_content TEXT;

    <span class=3D"hljs-comment">-- Declare a cursor over a query</span>
    <span class=3D"hljs-keyword">DECLARE</span> msg_cursor <span class=3D"h=
ljs-keyword">CURSOR</span> <span class=3D"hljs-keyword">FOR</span>
        <span class=3D"hljs-keyword">SELECT</span> message_id, content <spa=
n class=3D"hljs-keyword">FROM</span> messages <span class=3D"hljs-keyword">=
WHERE</span> status <span class=3D"hljs-operator">=3D</span> <span class=3D=
"hljs-string">&#x27;pending&#x27;</span>;

    <span class=3D"hljs-comment">-- Handler that sets `done =3D TRUE` when =
no more rows</span>
    <span class=3D"hljs-keyword">DECLARE</span> CONTINUE HANDLER <span clas=
s=3D"hljs-keyword">FOR</span> <span class=3D"hljs-keyword">NOT</span> FOUND=
 <span class=3D"hljs-keyword">SET</span> done <span class=3D"hljs-operator"=
>=3D</span> <span class=3D"hljs-literal">TRUE</span>;

    <span class=3D"hljs-keyword">OPEN</span> msg_cursor;

    read_loop: LOOP
        <span class=3D"hljs-keyword">FETCH</span> msg_cursor <span class=3D=
"hljs-keyword">INTO</span> msg_id, msg_content;
        IF done <span class=3D"hljs-keyword">THEN</span> LEAVE read_loop; <=
span class=3D"hljs-keyword">END</span> IF;

