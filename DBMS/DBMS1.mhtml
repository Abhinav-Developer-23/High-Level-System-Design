<h3 id=3D"viewing--managing-triggers" data-toc=3D"Viewing &amp; Managing Tr=
iggers">Viewing &amp; Managing Triggers</h3>
<div class=3D"code"><div class=3D"code-bar"><span class=3D"dots"><i></i><i>=
</i><i></i></span><span class=3D"lang">SQL</span></div><pre><code class=3D"=
hljs"><span class=3D"hljs-comment">-- List all triggers (SQL Server)</span>
<span class=3D"hljs-keyword">SELECT</span> name, is_instead_of_trigger
<span class=3D"hljs-keyword">FROM</span> sys.triggers
<span class=3D"hljs-keyword">WHERE</span> type <span class=3D"hljs-operator=
">=3D</span> <span class=3D"hljs-string">&#x27;TR&#x27;</span>;

<span class=3D"hljs-comment">-- List all triggers (MySQL)</span>
<span class=3D"hljs-keyword">SHOW</span> TRIGGERS;

<span class=3D"hljs-comment">-- Drop a trigger</span>
<span class=3D"hljs-keyword">DROP</span> <span class=3D"hljs-keyword">TRIGG=
ER</span> trigger_name;

<span class=3D"hljs-comment">-- Drop a trigger only if it exists (MySQL =E2=
=80=94 no error if it&#x27;s missing)</span>
<span class=3D"hljs-keyword">DROP</span> <span class=3D"hljs-keyword">TRIGG=
ER</span> IF <span class=3D"hljs-keyword">EXISTS</span> trigger_name;</code=
></pre></div>
