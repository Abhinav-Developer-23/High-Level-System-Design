<h6 id=3D"-at-a-glance">=F0=9F=93=8A At a glance</h6>
<div class=3D"tbl"><table>
<thead>
<tr>
<th style=3D"text-align:left"></th>
<th style=3D"text-align:left">=F0=9F=9F=A2 <code>WHERE</code></th>
<th style=3D"text-align:left">=F0=9F=94=B5 <code>HAVING</code></th>
</tr>
