      <span class=3D"t-k">"loyaltyNumber"</span>: <span class=3D"t-s">"9123=
456789"</span>       <span class=3D"t-c">// optional (SkyMiles)</span>
    },
    { <span class=3D"t-k">"passengerRef"</span>: <span class=3D"t-s">"p2"</=
span>, <span class=3D"t-k">"type"</span>: <span class=3D"t-s">"ADULT"</span=
>, <span class=3D"t-k">"firstName"</span>: <span class=3D"t-s">"Riya"</span=
>, <span class=3D"t-k">"lastName"</span>: <span class=3D"t-s">"Kumar"</span=
>, <span class=3D"t-k">"dateOfBirth"</span>: <span class=3D"t-s">"1997-09-0=
