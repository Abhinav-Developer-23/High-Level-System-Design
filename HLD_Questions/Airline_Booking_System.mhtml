  <span class=3D"t-k">"destination"</span>: <span class=3D"t-s">"LGA"</span=
>,

  <span class=3D"t-c">// 2. departDate =E2=80=94 local date at the departur=
e airport (one-way only)</span>
  <span class=3D"t-k">"departDate"</span>: <span class=3D"t-s">"2026-12-20"=
</span>,

  <span class=3D"t-c">// 3. passengers =E2=80=94 counts by type. 1=E2=80=93=
9 in total (airline limit per booking)</span>
