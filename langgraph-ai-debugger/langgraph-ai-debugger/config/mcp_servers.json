{
  "_comment": "Template. ${ROOT} = project root, ${NAME} = value from .env. Rendered to var/mcp.runtime.json (0600) by ai_debugger.mcp_config — never put a secret in this file. `_meta` is stripped before Claude Code sees it.",
  "mcpServers": {
    "tpap_redash": {
      "command": "/bin/bash",
      "args": [
        "${ROOT}/scripts/mcp-stdio.sh",
        "tpap_redash",
        "${ROOT}/.venv/bin/python3",
        "${ROOT}/mcp_servers/tpap/mcp/tpap_redash_mcp.py"
      ],
      "env": {
        "REDASH_BASE_URL": "${REDASH_BASE_URL}",
        "REDASH_API_KEY": "${REDASH_API_KEY}"
      },
      "_meta": {
        "system": "tpap",
        "label": "Redash — DB rows (SQL, 20s timeout)",
        "kind": "db"
      }
    },
    "tpap_trino": {
      "command": "/bin/bash",
      "args": [
        "${ROOT}/scripts/mcp-stdio.sh",
        "tpap_trino",
        "${ROOT}/.venv/bin/python3",
        "${ROOT}/mcp_servers/tpap/mcp/tpap_trino_mcp.py"
      ],
      "_meta": {
        "system": "tpap",
        "label": "Trino — DB rows",
        "kind": "db"
      }
    },
    "tpap_elk": {
      "command": "/bin/bash",
      "args": [
        "${ROOT}/scripts/mcp-stdio.sh",
        "tpap_elk",
