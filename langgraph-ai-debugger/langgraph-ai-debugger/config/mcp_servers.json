        "${ROOT}/mcp_servers/tpap/mcp/tpap_archival_logs_mcp.py"
      ],
      "_meta": {
        "system": "tpap",
        "label": "Archival logs (> 3d)",
        "kind": "logs"
      }
    },
    "tpap_grafana": {
      "command": "/bin/bash",
      "args": [
        "${ROOT}/scripts/mcp-stdio.sh",
        "tpap_grafana",
        "${ROOT}/.venv-ext/bin/mcp-grafana",
        "--disable-write",
        "--log-level",
        "error",
        "--enabled-tools",
        "search,datasource,prometheus,dashboard,navigation,alerting"
      ],
      "env": {
        "GRAFANA_URL": "${TPAP_GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${TPAP_GRAFANA_SERVICE_ACCOUNT_TOKEN}",
        "GRAFANA_ORG_ID": "${TPAP_GRAFANA_ORG_ID}"
      },
      "_meta": {
        "system": "tpap",
        "label": "Grafana + Prometheus (read-only)",
        "kind": "metrics",
        "deny": [
          "alerting_manage_silences",
          "alerting_manage_routing"
        ]
      }
    },
    "tpap_atlassian": {
      "command": "/bin/bash",
      "args": [
        "${ROOT}/scripts/mcp-stdio.sh",
        "tpap_atlassian",
        "${ROOT}/.venv-ext/bin/mcp-atlassian",
        "--read-only",
        "--toolsets",
        "default"
      ],
      "env": {
        "JIRA_URL": "${TPAP_ATLASSIAN_URL}",
        "JIRA_USERNAME": "${TPAP_ATLASSIAN_USERNAME}",
        "JIRA_API_TOKEN": "${TPAP_ATLASSIAN_API_TOKEN}",
        "CONFLUENCE_URL": "${TPAP_ATLASSIAN_URL}",
        "CONFLUENCE_USERNAME": "${TPAP_ATLASSIAN_USERNAME}",
        "CONFLUENCE_API_TOKEN": "${TPAP_ATLASSIAN_API_TOKEN}",
        "READ_ONLY_MODE": "true",
        "TOOLSETS": "default"
      },
      "_meta": {
        "system": "tpap",
        "label": "Jira + Confluence (read-only)",
        "kind": "docs"
      }
    },
