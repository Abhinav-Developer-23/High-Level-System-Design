      ],
      "_meta": {
        "system": "tpap",
        "label": "Elasticsearch / Kibana (3d)",
        "kind": "logs"
      }
    },
    "tpap_archival_logs": {
      "command": "/bin/bash",
      "args": [
        "${ROOT}/scripts/mcp-stdio.sh",
