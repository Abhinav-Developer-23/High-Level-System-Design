      "args": [
        "${ROOT}/scripts/mcp-stdio.sh",
        "notion_cursor",
        "/bin/bash",
        "${ROOT}/scripts/notion-mcp.sh"
      ],
      "_meta": {
        "system": "shared",
        "label": "Notion (writes blocked unless ALLOW_NOTION_WRITES=1)",
        "kind": "docs",
        "deny_unless_env": "ALLOW_NOTION_WRITES",
        "deny": [
          "API-patch-block-children",
          "API-update-a-block",
          "API-delete-a-block",
          "API-patch-page",
          "API-post-page",
          "API-create-a-comment",
          "API-update-a-data-source",
          "API-create-a-data-source",
          "API-move-page",
          "API-update-page-markdown"
        ]
      }
    },
    "chrome-devtools": {
      "command": "/opt/homebrew/bin/npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/bin:/bin"
      },
      "_meta": {
        "system": "shared",
        "label": "Chrome DevTools (drives your Chrome)",
        "kind": "browser",
        "default_off": true
      }
