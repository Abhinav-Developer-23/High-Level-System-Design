# langgraph-ai-debugger — variable NAMES only. Real values live in `.env` (chmod 600, gitignored).
# The app reads only the agent knobs, ANTHROPIC_API_KEY and the Redash values itself; the rest are
# handed to each MCP server's process from config/mcp_servers.json, never exported to the app's env.

# --- agent (every LLM step is ChatAnthropic → the Anthropic Messages API) ---
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
# longest reply one call may write; timeout of one API call
AGENT_MAX_TOKENS=8192
AGENT_LLM_TIMEOUT_S=300
# tool calls per turn before the agent must answer; tool results are cut to this many characters
AGENT_MAX_TOOL_CALLS=30
AGENT_TOOL_OUTPUT_CHARS=12000
# LangGraph super-steps per turn (every tool round is two: agent + tools)
AGENT_RECURSION_LIMIT=150
# USD per million tokens for AGENT_MODEL (here Claude Sonnet 5). Used for the cost shown in the UI
# and for the monthly budget below; with 0 nothing is counted and the budget never triggers.
AGENT_PRICE_IN_PER_MTOK=2
AGENT_PRICE_OUT_PER_MTOK=10
AGENT_PRICE_CACHE_READ_PER_MTOK=0.20
# prompt caching: tools + system prompt + the conversation so far are cached on Anthropic's side
AGENT_PROMPT_CACHE=1
# 5m (cache write = 1.25x input price) or 1h (2x; worth it when follow-ups come 5-60 min apart)
AGENT_CACHE_TTL=5m
# compaction (high/low watermark): once a prompt reaches the trigger, older turns are summarized
# by the cheaper model and only the last N turns stay word for word
AGENT_COMPACT_TRIGGER_TOKENS=120000
AGENT_COMPACT_KEEP_TURNS=2
AGENT_SUMMARY_MODEL=claude-haiku-5-5
# how many times review may send the investigator back for more evidence
AGENT_MAX_REVIEW_LOOPS=1
AGENT_PLAN=1
AGENT_REVIEW=1
# load the MCP servers as LangGraph tools at startup (0 = native DB/file tools only)
MCP_LOAD=1
MCP_LOAD_TIMEOUT_S=60
# comma-separated MCP server names to never attach
MCP_DISABLED=
# Notion is the one read/write server; its write tools stay blocked unless this is 1
ALLOW_NOTION_WRITES=0

# --- web UI ---
APP_HOST=127.0.0.1
APP_PORT=8077
# questions per user per day (resets at midnight IST); 0 = no limit
AGENT_DAILY_QUESTIONS_PER_USER=100
# $ per user per calendar month (IST); 0 = no cap. 10 users x $500 = $5,000/month at most.
AGENT_MONTHLY_BUDGET_USD_PER_USER=500
# the app sits behind the company login, which passes the logged-in user's name in this header
AUTH_USER_HEADER=X-Forwarded-User

# --- TPAP ---
TPAP_GRAFANA_URL=
TPAP_GRAFANA_SERVICE_ACCOUNT_TOKEN=
TPAP_GRAFANA_ORG_ID=
TPAP_ATLASSIAN_URL=
TPAP_ATLASSIAN_USERNAME=
TPAP_ATLASSIAN_API_TOKEN=
TPAP_PAYTMCALLER_URL=
TPAP_PAYTMCALLER_USER_EMAIL_B64=
TPAP_PAYTMCALLER_PASSWORD_B64=
TPAP_PAYTMCALLER_ORG_ID=
TPAP_PMM_URL=
TPAP_PMM_BASIC_AUTH=
TPAP_PMM_INSECURE_SKIP_VERIFY=true
TPAP_AMC_URL=
TPAP_AMC_SEED=
TECHOPS_AGENT_PASSWORD=
# Redash for the native DB tools (tools/db.py)
REDASH_BASE_URL=
REDASH_API_KEY=
# TPAP_PROD_JENKINS_TOKEN lives in ~/.zshrc only — never here

# --- TSP ---
TSP_REDASH_URL=
TSP_REDASH_API_KEY=
TSP_GRAFANA_URL=
TSP_GRAFANA_SERVICE_ACCOUNT_TOKEN=
TSP_ATLASSIAN_URL=
TSP_ATLASSIAN_USERNAME=
TSP_ATLASSIAN_API_TOKEN=
TSP_JENKINS_URL=
TSP_JENKINS_USER=
TSP_JENKINS_TOKEN=
TSP_PROD_ARGOCD_URL=
TSP_PROD_ARGOCD_USER=
TSP_PROD_ARGOCD_TOKEN=
TSP_ZENDUTY_URL=
TSP_ZENDUTY_API_TOKEN=
TSP_PMM_URL=
TSP_PMM_BASIC_AUTH=
TSP_AMC_URL=
TSP_AMC_SEED=

# --- shared ---
BITBUCKET_URL=
BITBUCKET_WORKSPACE=
BITBUCKET_USERNAME=
BITBUCKET_PASSWORD=
JARVIS_BITBUCKET_URL=
JARVIS_BITBUCKET_USERNAME=
JARVIS_BITBUCKET_API_TOKEN=
JARVIS_BITBUCKET_WORKSPACE=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_SCOPES=
GMAIL_READONLY_REFRESH_TOKEN=
GMAIL_READONLY_SCOPES=
NOTION_TOKEN=
JENKINS_URL=
JENKINS_USER=
JENKINS_API_TOKEN=
SONAR_TOKEN=
