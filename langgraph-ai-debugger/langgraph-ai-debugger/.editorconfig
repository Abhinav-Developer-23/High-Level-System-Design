# https://editorconfig.org — makes every editor agree on the basics.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120

[*.{js,mjs,css,html,json,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false  # two trailing spaces are a markdown line break

[Makefile]
indent_style = tab
