// Golden cases for `ai-debugger eval`. One JSON object per line; lines starting with // are skipped.
// ids, txn ids and facts below are examples: replace them with real, reviewed cases from your own threads.
{"id": "txn-u30", "question": "tsp: why did txn PTM1a34942533d8409c92df31424d37ee25 fail?", "system": "tsp", "reference": "The payer bank declined the debit with NPCI code U30 (debit failed at the remitter bank). The switch handled it correctly; no action on our side, the customer should retry or contact their bank.", "must_include": ["U30"], "expected_tools": ["get_txn"]}
{"id": "rrn-pending", "question": "tsp: customer says RRN 630512345678 is stuck pending since this morning", "system": "tsp", "reference": "Find the txn by RRN, check its status and the NPCI response; a long PENDING means the check-status / reversal flow should be followed and the timeline given.", "must_include": ["PENDING"], "expected_tools": ["find_txn_by_rrn"]}
{"id": "failure-spike", "question": "tsp: how many transactions failed in the last 30 minutes and with which codes?", "system": "tsp", "reference": "A count of FAILURE transactions in the last 30 minutes grouped by NPCI response code, with the top codes explained.", "expected_tools": ["txn_status_counts"]}
{"id": "npci-lookup", "question": "what does ZM mean?", "reference": "ZM is an NPCI response code for an invalid / incorrect MPIN entered by the customer.", "must_include": ["ZM"], "budget_usd": 0.01}
